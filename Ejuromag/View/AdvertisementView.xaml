<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Ejuromag.View.AdvertisementView"
             Title="AdvertisementView"
             BackgroundColor="#026691">
    <ScrollView>
    <VerticalStackLayout>
        <Label Text="Xiaomi Redmi Pad SE" TextColor="White" FontSize="Large"  FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,20,0,0" TextDecorations="Underline"/>
        <toolkit:MediaElement x:Name="one_ME" WidthRequest="400" HeightRequest="300" Source="embed://RedmiPadteszt.mp4" Margin="5"/>
        <Label Text="Samsung Galaxy A54" TextColor="White" FontSize="Large"  FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,20,0,0" TextDecorations="Underline"/>
        <toolkit:MediaElement x:Name="two_ME" WidthRequest="400" HeightRequest="300" Source="embed://SamsungGalaxyA54.mp4" Margin="5"/>
        <Label Text="Acer Aspire 3" TextColor="White" FontSize="Large"  FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,20,0,0" TextDecorations="Underline"/>
        <toolkit:MediaElement x:Name="three_ME" WidthRequest="400" HeightRequest="300" Source="embed://AcerAspire3.mp4" Margin="5"/>
    </VerticalStackLayout>
</ScrollView>
    
</ContentPage>
